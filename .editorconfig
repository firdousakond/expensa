root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4



# iOS interop: MainViewController() is a Swift-facing factory, so it is PascalCase.
[**/iosMain/**/*.kt]
ktlint_standard_function-naming = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
